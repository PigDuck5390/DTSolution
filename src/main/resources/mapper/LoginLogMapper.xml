<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.dtsolution.auth.mapper.LoginLogMapper">

    <resultMap id="logResultMap" type="LoginLog">
        <id     property="id"         column="id"/>
        <result property="empNo"      column="emp_no"/>
        <result property="loginAt"    column="login_at"/>
        <result property="logoutAt"   column="logout_at"/>
        <result property="ipAddress"  column="ip_address"/>
        <result property="success"    column="success" javaType="boolean" jdbcType="NUMERIC"/>
        <result property="reason"     column="reason"/>
    </resultMap>

    <insert id="insertLog" parameterType="LoginLog">
        INSERT INTO login_log (emp_no, login_at, ip_address, success, reason)
        VALUES (#{empNo}, SYSDATE, #{ipAddress},
                #{success, javaType=boolean, jdbcType=NUMERIC}, #{reason})
    </insert>

    <select id="findLatestActiveLog" resultMap="logResultMap">
        SELECT *
        FROM   login_log
        WHERE  emp_no    = #{empNo}
          AND  success   = 1
          AND  logout_at IS NULL
          AND  ROWNUM    = 1
        ORDER  BY login_at DESC
    </select>

    <update id="updateLogoutAt">
        UPDATE login_log SET logout_at = #{logoutAt} WHERE id = #{id}
    </update>

</mapper>